+async def _forecast_request(client: AsyncClient, url: str, params: dict[str, Any]):
+    """Retry one transient service failure, leaving error handling to the caller."""
+    for attempt in range(2):
+        response = await client.get(url, params=params)
+        if response.status_code != 503 or attempt == 1:
+            return response
