{
  "version": 1,
  "tests": [
    {
      "id": "current-refund",
      "input": {
        "requests": [
          {
            "question": "refund policy"
          }
        ]
      },
      "expect": {
        "json": [
          {
            "path": "/responses",
            "check": {
              "op": "length",
              "min": 1,
              "max": 1
            }
          },
          {
            "path": "/responses",
            "each": "/text",
            "check": {
              "op": "length",
              "min": 1
            }
          },
          {
            "path": "/responses/0/status",
            "check": {
              "op": "equals",
              "value": "answered"
            }
          },
          {
            "path": "/responses/0/citations",
            "check": {
              "op": "equals",
              "value": [
                "refund-current"
              ]
            }
          }
        ],
        "tools_called": [
          "search_documents"
        ],
        "output_contains": [
          "30 days"
        ],
        "output_not_contains": [
          "90 days"
        ]
      }
    },
